AI_PROVIDER=gemini
SUPPORTED_PROVIDERS=gemini,openai,groq,openrouter,claude

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

